# Public site URL (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Checkout (Shopify Storefront API) -------------------------------------
# Leave these empty until a real store is connected. While empty, the site
# shows checkout as "not connected" and never simulates a payment.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# gid://shopify/ProductVariant/<id> of the watch variant
SHOPIFY_VARIANT_ID=
# Storefront API version (quarterly release, e.g. 2026-07)
SHOPIFY_API_VERSION=2026-07
